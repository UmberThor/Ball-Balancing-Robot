<!--
Ball balancing robot, reduced to what the policy acts on: the plate and the ball.
The base parts and the ring are there only for looks, they have no mass and no collision.
The three arms are not simulated: the plate is driven kinematically through three joints 
by the environment through the inverse and forward kinematics, so the joints are set
from Python at every physics step.

Units: meters, kilograms, seconds.
-->
<mujoco model="ball_balancer">
  <compiler angle="radian" autolimits="true" meshdir="../3d files"/>

  <option timestep="0.002" integrator="implicitfast"/>

      <visual>
        <global offwidth="640" offheight="480"/>
        <quality shadowsize="4096"/>
        <headlight ambient="0.35 0.35 0.35" diffuse="0.5 0.5 0.5"/>
      </visual>

  <asset>
    <texture name="skybox" type="skybox" builtin="gradient" rgb1="0.85 0.88 0.92" rgb2="0.35 0.4 0.48" width="512" height="512"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.42 0.43 0.45" rgb2="0.36 0.37 0.39" width="512" height="512"/>
    <material name="floor" texture="grid" texrepeat="12 12" reflectance="0.05"/>
    <material name="printed" rgba="0.92 0.92 0.9 1" specular="0.1"/>
    <material name="plexiglass" rgba="0.50 0.70 1 0.10" specular="0.8" shininess="0.9"/>
    <material name="ball" rgba="1 0.45 0.7 1" specular="0.3"/>
    <!-- printed parts, in millimeters -->
    <mesh name="raspberry_bottom" file="raspberry_bottom.stl" scale="0.001 0.001 0.001"/>
    <mesh name="raspberry_top" file="raspberry_top.stl" scale="0.001 0.001 0.001"/>
    <mesh name="motor_base" file="motor_base.stl" scale="0.001 0.001 0.001"/>
    <mesh name="camera_cover" file="camera_cover.stl" scale="0.001 0.001 0.001"/>
    <mesh name="ring" file="plate.stl" scale="0.001 0.001 0.001"/>
  </asset>

  <default>
    <default class="visual">
      <geom type="mesh" material="printed" contype="0" conaffinity="0" group="1" density="0"/>
    </default>
  </default>

  <worldbody>
    <light pos="0.3 -0.3 0.8" dir="-0.3 0.3 -0.8" diffuse="0.6 0.6 0.6" castshadow="true"/>
    <geom name="floor" type="plane" size="0.5 0.5 0.01" pos="0 0 -0.0644" material="floor" contype="0" conaffinity="0"/>

    <!-- static body of the robot, visual only. The meshes keep the coordinates they were exported with,
         and the parts are apart in the assembly, so each frame moves one part: centred on the z axis
         and stacked on the faces that touch on the real robot, measured on the assembly (the top of
         the case and the motor base are 26 mm apart, the motor base and the camera cover 21.5 mm).
         The stack is anchored on the axes of the motors, z = 0 of the kinematics: they are at 52.8 in
         the assembly, 12.5 below the top face of the motor base -->
    <frame pos="-0.04745 -0.03295 -0.0644">
      <geom name="raspberry_bottom" class="visual" mesh="raspberry_bottom"/>
    </frame>
    <frame pos="-0.00251 -0.0034 -0.0268">
      <geom name="raspberry_top" class="visual" mesh="raspberry_top"/>
    </frame>
    <frame pos="-0.00251 -0.0034 -0.0528">
      <geom name="motor_base" class="visual" mesh="motor_base"/>
    </frame>
    <frame pos="-0.00251 -0.0034 -0.0743">
      <geom name="camera_cover" class="visual" mesh="camera_cover"/>
    </frame>

    <!-- the camera looks up at the plate, as the real one: image x along +x, image y along +y.
         it sits at the top face of the cover, and fovy is the vertical field of view of the OV5647.
         at this height the ball, whose centre is at h + 4 + R = 144 mm at the nominal pose, measures
         120/(0.124 tan(fovy/2)) = 2560 px/m, close to the 2500 px/m of PX_PER_M -->
    <camera name="below" pos="0 0 0.020" xyaxes="1 0 0 0 -1 0" fovy="41.4"/>
    <camera name="side" mode="targetbody" target="look_at" pos="0.26 -0.26 0.22"/>
    <body name="look_at" pos="0 0 0.05"/>

    <!-- plate: height along z, then tilt about y, then about x (R = Ry Rx) -->
    <body name="plate_lift">
      <joint name="plate_z" type="slide" axis="0 0 1"/>
      <inertial pos="0 0 0" mass="0.001" diaginertia="1e-6 1e-6 1e-6"/>
      <body name="plate_pitch">
        <joint name="plate_ry" type="hinge" axis="0 1 0"/>
        <inertial pos="0 0 0" mass="0.001" diaginertia="1e-6 1e-6 1e-6"/>
        <body name="plate">
          <joint name="plate_rx" type="hinge" axis="1 0 0"/>
          <!-- h of the kinematics is the plane of the ball joints, the middle of the 4 mm ring, so the
               2 mm disc rests 2 mm above the joint origin and its top surface, where the ball rolls, 4 mm above.
               mass: plexiglass, 1.18 g/cm^3 -->
          <geom name="plate" type="cylinder" size="0.075 0.001" pos="0 0 0.003" mass="0.042"
                material="plexiglass" friction="0.4 0.001 0.00002" solref="0.005 1"/>
          <!-- ring that holds the disc (inner radius 70 mm, outer 78 mm, 4 mm thick): the disc rests on top
               of it and the ball joints are at its middle, so the ring is centred on the joint origin -->
          <frame pos="-0.001 0 -0.12474">
            <geom name="ring" class="visual" mesh="ring"/>
          </frame>
        </body>
      </body>
    </body>

    <!-- ping pong ball: 40 mm, 2.7 g, hollow shell, so the inertia is 2/3 m R^2 and not the solid 2/5.
         the contact is stiffer than the default (solref 0.02): softer, it takes 7% off the rolling acceleration -->
    <body name="ball" pos="0 0 0.14">
      <freejoint name="ball"/>
      <inertial pos="0 0 0" mass="0.0027" diaginertia="7.2e-7 7.2e-7 7.2e-7"/>
      <geom name="ball" type="sphere" size="0.02" material="ball" condim="6" friction="0.4 0.001 0.00002" solref="0.005 1"/>
    </body>
  </worldbody>
</mujoco>
